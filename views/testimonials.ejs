<section class="page-hero">
  <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=1800&q=85" alt="Handshake in a boardroom" width="1800" height="1200">
  <div class="container">
    <div class="eyebrow">Client voices</div>
    <h1>Testimonials</h1>
    <p>Proof from patrons who commissioned leatherware and executives who completed our classes.</p>
  </div>
</section>

<div class="filter-bar">
  <div class="container filter-row" role="navigation" aria-label="Testimonial filters">
    <a href="/testimonials" class="<%= activeDivision === 'all' ? 'active' : '' %>" <%= activeDivision === 'all' ? 'aria-current="true"' : '' %>>All</a>
    <a href="/testimonials?division=bags" class="<%= activeDivision === 'bags' ? 'active' : '' %>" <%= activeDivision === 'bags' ? 'aria-current="true"' : '' %>>Bags clients</a>
    <a href="/testimonials?division=classes" class="<%= activeDivision === 'classes' ? 'active' : '' %>" <%= activeDivision === 'classes' ? 'aria-current="true"' : '' %>>Classes alumni</a>
  </div>
</div>

<section class="section">
  <div class="container">
    <% if (!testimonials.length) { %>
      <div class="empty-state" data-reveal>
        <h3>No testimonials in this filter</h3>
        <p class="lead">Satisfied clients appear here after admin review.</p>
        <a class="btn btn-ghost" href="/testimonials">Show all</a>
      </div>
    <% } else { %>
      <div class="grid-3">
        <% testimonials.forEach(function(t) { %>
          <blockquote class="quote-card" data-reveal>
            <div>
              <div class="stars" aria-label="<%= t.rating || 5 %> out of 5 stars"><%= '★'.repeat(t.rating || 5) %></div>
              <div class="label" style="margin:0.5rem 0"><%= t.division === 'bags' ? 'Bags client' : t.division === 'classes' ? 'Classes alumni' : 'House client' %></div>
              <p>“<%= t.quote %>”</p>
            </div>
            <footer class="quote-author">
              <div class="avatar" aria-hidden="true"><%= t.avatar_initials || 'RF' %></div>
              <div>
                <strong><%= t.client_name %></strong>
                <div class="label"><%= t.client_title %><% if (t.organization) { %>, <%= t.organization %><% } %></div>
              </div>
            </footer>
          </blockquote>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
