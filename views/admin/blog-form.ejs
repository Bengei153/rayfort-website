<div class="admin-top">
  <div>
    <div class="label">Blog</div>
    <h1 style="margin:0.25rem 0;color:var(--rf-navy-deep)"><%= post ? 'Edit story' : 'New story' %></h1>
  </div>
  <a href="/admin/blog">← Back</a>
</div>
<form class="form-card" method="post" action="<%= post ? '/admin/blog/' + post.id : '/admin/blog' %>" enctype="multipart/form-data">
  <div class="field"><label for="title">Title</label><input id="title" name="title" required value="<%= post ? post.title : '' %>"></div>
  <div class="field"><label for="slug">Slug</label><input id="slug" name="slug" value="<%= post ? post.slug : '' %>"></div>
  <div class="field"><label for="author">Author</label><input id="author" name="author" value="<%= post ? post.author : 'Rayfort Editorial' %>"></div>
  <div class="field"><label for="excerpt">Excerpt</label><textarea id="excerpt" name="excerpt" rows="2"><%= post ? post.excerpt : '' %></textarea></div>
  <div class="field"><label for="body">Body (HTML allowed)</label><textarea id="body" name="body" rows="10" required><%= post ? post.body : '' %></textarea></div>
  <div class="field"><label for="cover_image">Cover image URL</label><input id="cover_image" name="cover_image" value="<%= post ? post.cover_image : '' %>"></div>
  <div class="field"><label for="image">Upload cover</label><input id="image" name="image" type="file" accept="image/*"></div>
  <div class="check-row">
    <label><input type="checkbox" name="is_published" value="1" <%= !post || post.is_published ? 'checked' : '' %>> Published</label>
  </div>
  <button class="btn btn-primary" type="submit">Save story</button>
</form>
