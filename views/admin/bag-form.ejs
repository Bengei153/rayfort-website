<div class="admin-top">
  <div>
    <div class="label">Bag Designs</div>
    <h1 style="margin:0.25rem 0;color:var(--rf-navy-deep)"><%= bag ? 'Edit design' : 'Post new design' %></h1>
  </div>
  <a href="/admin/bags">← Back</a>
</div>

<form class="form-card" method="post" action="<%= bag ? '/admin/bags/' + bag.id : '/admin/bags' %>" enctype="multipart/form-data">
  <div class="field"><label for="title">Title</label><input id="title" name="title" required value="<%= bag ? bag.title : '' %>"></div>
  <div class="field"><label for="slug">Slug (optional)</label><input id="slug" name="slug" value="<%= bag ? bag.slug : '' %>" placeholder="auto-from-title"></div>
  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category" required>
      <% categories.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= bag && bag.category === c.id ? 'selected' : '' %>><%= c.label %></option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label for="code">SKU / Code</label><input id="code" name="code" value="<%= bag ? bag.code : '' %>"></div>
  <div class="field"><label for="summary">Short summary</label><textarea id="summary" name="summary" rows="2"><%= bag ? bag.summary : '' %></textarea></div>
  <div class="field"><label for="description">Full description</label><textarea id="description" name="description" rows="5"><%= bag ? bag.description : '' %></textarea></div>
  <div class="field"><label for="features">Features (comma-separated)</label><input id="features" name="features" value="<%= bag ? bag.features : '' %>"></div>
  <div class="field"><label for="badge">Badge</label><input id="badge" name="badge" value="<%= bag ? bag.badge : '' %>"></div>
  <div class="field"><label for="price_note">Price note</label><input id="price_note" name="price_note" value="<%= bag ? bag.price_note : '' %>"></div>
  <div class="field"><label for="image_url">Image URL (or upload below)</label><input id="image_url" name="image_url" value="<%= bag ? bag.image_url : '' %>"></div>
  <div class="field"><label for="image">Upload image</label><input id="image" name="image" type="file" accept="image/*"></div>
  <div class="field"><label for="sort_order">Sort order</label><input id="sort_order" name="sort_order" type="number" value="<%= bag ? bag.sort_order : 0 %>"></div>
  <div class="check-row">
    <label><input type="checkbox" name="is_published" value="1" <%= !bag || bag.is_published ? 'checked' : '' %>> Published</label>
    <label><input type="checkbox" name="is_featured" value="1" <%= bag && bag.is_featured ? 'checked' : '' %>> Featured on home</label>
  </div>
  <button class="btn btn-primary" type="submit"><%= bag ? 'Save changes' : 'Publish design' %></button>
</form>
