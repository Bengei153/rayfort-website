<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login — Rayfort</title>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="brand-mark" style="margin-bottom:0.75rem">R</div>
      <h1 style="margin:0 0 0.35rem;color:var(--rf-navy-deep);font-size:1.75rem">Admin sign-in</h1>
      <p class="lead" style="margin:0 0 1.25rem">Manage designs, stories, classes, and testimonials.</p>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash error"><%= error %></div>
      <% } %>
      <form method="post" action="/admin/login">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required value="<%= typeof email !== 'undefined' ? email : '' %>">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
