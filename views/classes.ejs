<section class="page-hero">
  <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1600&q=85" alt="Executive leadership workshop">
  <div class="container">
    <div class="eyebrow"><span class="dot"></span> Executive Classes · Separate from Bags</div>
    <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);color:#fff;max-width:20ch;margin:0.75rem 0">Communication &amp; Leadership Masterclasses</h1>
    <p style="color:#dce3ef;max-width:40rem;line-height:1.7">A dedicated academy division for boardroom rhetoric, media crisis handling, and C-suite presence — not retail leatherware.</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.25rem">
      <a class="btn btn-light" href="/contact#inquiry">Inquire for Corporate Cohort</a>
      <a class="btn btn-outline" href="#curriculum">Explore Modules</a>
    </div>
  </div>
</section>

<section class="section section-white">
  <div class="container stat-grid">
    <div class="stat"><strong>98%</strong><div class="label">Confidence Boost</div></div>
    <div class="stat"><strong>250+</strong><div class="label">Executives Trained</div></div>
    <div class="stat"><strong>4:1</strong><div class="label">Coach Ratio</div></div>
    <div class="stat"><strong>100%</strong><div class="label">Video-Reviewed</div></div>
  </div>
</section>

<section class="section" id="curriculum">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="label">Five Pillar Foundations</div>
        <h2 style="margin:0.35rem 0;color:var(--rf-navy-deep)">Core Masterclass Curricula</h2>
        <p class="lead">Each programme is listed separately from the Rayfort Bags catalogue.</p>
      </div>
    </div>
    <% if (!classes.length) { %>
      <div class="card" style="padding:2rem;text-align:center">
        <h3 style="color:var(--rf-navy)">No classes published yet</h3>
        <p class="lead">Contact admissions for a private curriculum brief.</p>
      </div>
    <% } else { %>
      <div class="grid-2">
        <% classes.forEach(function(course) { %>
          <article class="card">
            <a href="/classes/<%= course.slug %>" class="card-media" style="aspect-ratio:16/10">
              <% if (course.image_url) { %><img src="<%= course.image_url %>" alt="<%= course.title %>" loading="lazy"><% } %>
            </a>
            <div class="card-body">
              <div class="label"><%= course.module_label || 'Programme' %></div>
              <h3 style="margin:0"><a href="/classes/<%= course.slug %>" style="text-decoration:none;color:var(--rf-navy)"><%= course.title %></a></h3>
              <p class="lead" style="margin:0;font-size:0.9rem"><%= course.summary %></p>
              <div class="label"><%= course.duration || '' %><% if (course.format) { %> · <%= course.format %><% } %></div>
              <a class="btn btn-ghost" style="align-self:start" href="/classes/<%= course.slug %>">View module</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-muted">
  <div class="container" style="display:grid;gap:1.5rem;grid-template-columns:1fr">
    <div class="card" style="padding:2rem;background:var(--rf-navy);color:#fff">
      <div class="eyebrow">Executive Admissions</div>
      <h2 style="color:#fff;margin:0.5rem 0">Book a Cohort or Private Advisory</h2>
      <p style="color:#dce3ef;max-width:36rem">Schedule a diagnostic call. We curate a bespoke curriculum for your leadership team — independent of bag commissions.</p>
      <a class="btn btn-light" style="margin-top:1rem" href="/contact#inquiry">Submit Inquiry</a>
    </div>
  </div>
</section>
