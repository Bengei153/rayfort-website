<section class="page-hero">
  <img src="https://images.unsplash.com/photo-1591561954557-26941169b49e?auto=format&fit=crop&w=1800&q=85" alt="Luxury leather tote on a workshop table" width="1800" height="1200">
  <div class="container">
    <div class="eyebrow">Atelier Division · <%= site.rc %></div>
    <h1>The art of handcrafted leather</h1>
    <p>Rayfort Bags is a dedicated division — separate from our executive classes — focused solely on heirloom leatherware.</p>
    <div class="actions">
      <a class="btn btn-light magnetic" href="#catalogue">Explore catalogue</a>
      <a class="btn btn-outline magnetic" href="/contact#inquiry">Institutional orders</a>
    </div>
  </div>
</section>

<div class="filter-bar" id="catalogue">
  <div class="container filter-row" role="navigation" aria-label="Bag categories">
    <% categories.forEach(function(cat) { %>
      <a href="/bags<%= cat.id === 'all' ? '' : '?category=' + cat.id %>" class="<%= activeCategory === cat.id ? 'active' : '' %>" <%= activeCategory === cat.id ? 'aria-current="true"' : '' %>><%= cat.label %></a>
    <% }) %>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <div class="label">Master archive · Editions</div>
        <h2>Curated Rayfort catalogue</h2>
      </div>
      <p class="lead" style="margin:0"><%= bags.length %> design<%= bags.length === 1 ? '' : 's' %> in this view</p>
    </div>

    <% if (!bags.length) { %>
      <div class="empty-state" data-reveal>
        <h3>No designs in this category yet</h3>
        <p class="lead">Browse the full catalogue or inquire for a bespoke commission.</p>
        <a class="btn btn-primary" href="/bags">All collections</a>
      </div>
    <% } else { %>
      <div class="grid-3">
        <% bags.forEach(function(bag) { %>
          <article class="tile" data-reveal>
            <a href="/bags/<%= bag.slug %>" class="tile-media" aria-label="<%= bag.title %>">
              <% if (bag.image_url) { %><img src="<%= bag.image_url %>" alt="<%= bag.title %>" loading="lazy" width="640" height="800"><% } %>
              <% if (bag.badge) { %><span class="badge"><%= bag.badge %></span><% } %>
            </a>
            <div class="tile-body">
              <div class="tile-meta">
                <span><%= bag.category %></span>
                <span style="color:var(--rf-crimson-deep);font-weight:700"><%= bag.code || '' %></span>
              </div>
              <h3><a href="/bags/<%= bag.slug %>"><%= bag.title %></a></h3>
              <p class="lead" style="font-size:0.9rem"><%= bag.summary %></p>
              <% if (bag.features && bag.features.length) { %>
                <div class="chip-row">
                  <% bag.features.slice(0,3).forEach(function(f) { %><span class="chip"><%= f %></span><% }) %>
                </div>
              <% } %>
              <div class="tile-foot">
                <span class="label"><%= bag.price_note || 'Inquire' %></span>
                <a class="btn btn-primary" style="padding:0.55rem 0.9rem;min-height:40px" href="/contact?interest=<%= encodeURIComponent(bag.title) %>#inquiry">Inquire</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
