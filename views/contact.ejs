<section class="section">
  <div class="container contact-layout">
    <div data-reveal>
      <div class="label">Direct concierge</div>
      <h1 style="font-size:clamp(2rem,4vw,2.75rem);margin:0.4rem 0 0.75rem">Contact Rayfort Investment</h1>
      <p class="lead">Catalogue requests, bespoke leather commissions, and executive class admissions — routed to the correct division.</p>
      <div class="contact-facts glass">
        <a href="tel:+2348035281272"><%= site.phone %></a>
        <a href="mailto:<%= site.email %>"><%= site.email %></a>
        <div style="color:var(--rf-muted)"><%= site.address %></div>
        <div class="label"><%= site.rc %> · Confidential protocol</div>
      </div>
    </div>

    <div id="inquiry" data-reveal>
      <div class="form-card">
        <div style="display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:1rem;flex-wrap:wrap">
          <h2 style="margin:0;font-size:1.5rem">Send an inquiry</h2>
          <span class="label">We reply promptly</span>
        </div>
        <% if (flash) { %>
          <div class="flash <%= flash.type %>" role="status"><%= flash.message %></div>
        <% } %>
        <form method="post" action="/contact">
          <div class="field">
            <label for="full_name">Full name &amp; title</label>
            <input id="full_name" name="full_name" required autocomplete="name" placeholder="e.g. Dr. Ngozi Adeleke, Director">
          </div>
          <div class="field">
            <label for="email">Corporate / private email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="director@organization.com">
          </div>
          <div class="field">
            <label for="phone">Phone <span style="font-weight:500;letter-spacing:0;text-transform:none;color:var(--rf-muted-2)">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+234 …">
          </div>
          <div class="field">
            <label for="interest">Primary area of interest</label>
            <select id="interest" name="interest">
              <% if (typeof queryInterest !== 'undefined' && queryInterest) { %><option selected><%= queryInterest %></option><% } %>
              <option>Rayfort Bags — Master Catalogue &amp; Bespoke Order</option>
              <option>Executive Communication Classes</option>
              <option>Corporate Gifting Commission</option>
              <option>C-Suite Private Oratory Masterclass</option>
              <option>Both Divisions Consultation</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Brief</label>
            <textarea id="message" name="message" rows="4" placeholder="Share volume, timeline, or training objectives…"><%= (typeof queryInterest !== 'undefined' && queryInterest) ? ('Inquiry regarding: ' + queryInterest) : '' %></textarea>
            <p class="hint">Include timing and whether this is leather, training, or both.</p>
          </div>
          <button class="btn btn-primary" type="submit">Send inquiry</button>
        </form>
      </div>
    </div>
  </div>
</section>
