<section class="page-hero">
  <img src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1800&q=85" alt="Editorial writing desk" width="1800" height="1200">
  <div class="container">
    <div class="eyebrow">Rayfort editorial</div>
    <h1>Stories &amp; insights</h1>
    <p>Craft notes from the atelier and leadership essays from the academy.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!posts.length) { %>
      <div class="empty-state" data-reveal>
        <h3>No stories published yet</h3>
        <p class="lead">Check back soon for new editorial from Rayfort.</p>
        <a class="btn btn-primary" href="/contact#inquiry">Get in touch</a>
      </div>
    <% } else { %>
      <div class="grid-3">
        <% posts.forEach(function(post) { %>
          <article class="tile" data-reveal>
            <a href="/blog/<%= post.slug %>" class="tile-media" style="aspect-ratio:16/10" aria-label="<%= post.title %>">
              <% if (post.cover_image) { %><img src="<%= post.cover_image %>" alt="" loading="lazy" width="640" height="400"><% } %>
            </a>
            <div class="tile-body">
              <div class="label"><%= post.published_label %> · <%= post.author %></div>
              <h2 style="font-size:1.35rem;margin:0"><a href="/blog/<%= post.slug %>" style="text-decoration:none;color:var(--rf-navy-deep)"><%= post.title %></a></h2>
              <p class="lead" style="font-size:0.9rem"><%= post.excerpt %></p>
              <a class="btn btn-ghost" style="align-self:start;margin-top:0.35rem" href="/blog/<%= post.slug %>">Read story</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
