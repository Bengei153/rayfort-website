PORT=3000
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres connection string — fill this in before running
# Examples:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/rayfort
# DATABASE_URL=postgresql://user:pass@host:5432/rayfort?sslmode=require
DATABASE_URL=

# Set to true for hosted Postgres that requires SSL (Neon, Supabase, Railway, etc.)
DATABASE_SSL=false
